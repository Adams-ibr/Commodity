rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // PERFORMANCE-OPTIMISED RULES
    //
    // Role enforcement is handled in the application service layer.
    // These rules use request.auth only (no get() calls) to avoid the
    // extra Firestore read on every request that caused slow page loads.
    //
    // The only exception is the users collection which uses existsAfter()
    // for self-registration safety — this does NOT trigger an extra read.
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // Any signed-in user can read any profile (needed for lookups).
    // A user can only create/update their own profile document.
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false; // use is_active:false instead
    }

    // ─────────────────────────────────────────────────────────────────────────
    // AUDIT LOGS — append-only
    // ─────────────────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ALL OTHER COLLECTIONS — any authenticated user can read/write.
    // Role-based restrictions are enforced in the service layer (TypeScript).
    // ─────────────────────────────────────────────────────────────────────────
    match /suppliers/{id}             { allow read, write: if isSignedIn(); }
    match /buyers/{id}                { allow read, write: if isSignedIn(); }
    match /commodity_categories/{id}  { allow read, write: if isSignedIn(); }
    match /commodity_types/{id}       { allow read, write: if isSignedIn(); }
    match /purchase_contracts/{id}    { allow read, write: if isSignedIn(); }
    match /purchase_contract_items/{id} { allow read, write: if isSignedIn(); }
    match /advance_payments/{id}      { allow read, write: if isSignedIn(); }
    match /sales_contracts/{id}       { allow read, write: if isSignedIn(); }
    match /sales_contract_items/{id}  { allow read, write: if isSignedIn(); }
    match /commodity_batches/{id}     { allow read, write: if isSignedIn(); }
    match /goods_receipts/{id}        { allow read, write: if isSignedIn(); }
    match /batch_movements/{id}       { allow read, write: if isSignedIn(); }
    match /quality_tests/{id}         { allow read, write: if isSignedIn(); }
    match /processing_orders/{id}     { allow read, write: if isSignedIn(); }
    match /shipments/{id}             { allow read, write: if isSignedIn(); }
    match /shipment_batches/{id}      { allow read, write: if isSignedIn(); }
    match /accounts/{id}              { allow read, write: if isSignedIn(); }
    match /journal_entries/{id}       { allow read, write: if isSignedIn(); }
    match /journal_entry_lines/{id}   { allow read, write: if isSignedIn(); }
    match /exchange_rates/{id}        { allow read, write: if isSignedIn(); }
    match /trade_finance/{id}         { allow read, write: if isSignedIn(); }
    match /compliance_records/{id}    { allow read, write: if isSignedIn(); }
    match /export_compliance/{id}     { allow read, write: if isSignedIn(); }
    match /invoices/{id}              { allow read, write: if isSignedIn(); }
    match /documents/{id}             { allow read, write: if isSignedIn(); }
    match /locations/{id}             { allow read, write: if isSignedIn(); }
    match /_sequences/{id}            { allow read, write: if isSignedIn(); }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
